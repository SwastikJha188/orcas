{
  "name": "ultron",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --turbopack",
    "dev:api": "npm run dev -w backend",
    "dev:webpack": "next dev",
    "build": "next build && npm run build -w backend",
    "start": "next start",
    "start:api": "npm run start -w backend",
    "preview": "next build && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck -w backend",
    "mqtt:broker": "node scripts/mqtt-dev-broker.mjs",
    "mqtt:sim": "node scripts/mqtt-gateway-sim.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:status": "node --env-file=.env.local scripts/db-migrate.mjs --status",
    "db:export-fixture": "node --env-file=.env.local scripts/db-export-fixture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "mqtt": "^5.16.0",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.180.0",
    "aedes": "^0.51.3",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.8.3"
  }
}
