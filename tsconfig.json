{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-memtest-prod/types/**/*.ts",
    ".next-memtest-tp/types/**/*.ts",
    ".next-memtest-wp/types/**/*.ts",
    ".next-verify-97703c/types/**/*.ts",
    ".next-verify-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-preview/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "LiquidGlassSkill-main/**",
    "liquid-glass-skill-main/**"
  ]
}
