# Server-only values belong here. Never expose secrets with a NEXT_PUBLIC_ prefix.
DATABASE_URL=
DIRECT_URL=

# MQTT brokers are not configured here. Add them in Devices › MQTT; they are
# stored in the database (edge registry) together with their gateways, sources
# and points. Local loop: `npm run mqtt:broker` + `npm run mqtt:sim`, then
# enable the "brk-local" broker (127.0.0.1:1883) in Devices › MQTT.

# ULTRON sign-in demo accounts (values in .env.local): ULTRON_DEMO_<NAME>_EMAIL / ULTRON_DEMO_<NAME>_PASSWORD
ULTRON_DEMO_ADMIN_EMAIL=
ULTRON_DEMO_ADMIN_PASSWORD=
ULTRON_DEMO_PYRO_EMAIL=
ULTRON_DEMO_PYRO_PASSWORD=
