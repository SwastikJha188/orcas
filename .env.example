# Server-only values belong here. Never expose secrets with a NEXT_PUBLIC_ prefix.
DATABASE_URL=
DIRECT_URL=

# MQTT brokers are not configured here. Add them in Devices › MQTT; they are
# stored in the database (edge registry) together with their gateways, sources
# and points. Local loop: `npm run mqtt:broker` + `npm run mqtt:sim`, then
# enable the "brk-local" broker (127.0.0.1:1883) in Devices › MQTT.

# ULTRON sign-in demo accounts (values in .env.local): ULTRON_DEMO_<NAME>_EMAIL / ULTRON_DEMO_<NAME>_PASSWORD
ULTRON_DEMO_ADMIN_EMAIL=
ULTRON_DEMO_ADMIN_PASSWORD=
ULTRON_DEMO_PYRO_EMAIL=
ULTRON_DEMO_PYRO_PASSWORD=
ULTRON_DEMO_VPC_EMAIL=
ULTRON_DEMO_VPC_PASSWORD=

# Outgoing email (demo-request notifications). oswarteck.com mail is Microsoft 365:
# smtp.office365.com:587 with a mailbox that has SMTP AUTH enabled. Password in .env.local only.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Where "Request a demo" submissions from the sign-in page are emailed.
DEMO_REQUEST_NOTIFY_TO=info@oswarteck.com

# Support tickets (Configure › Support) are emailed here; falls back to DEMO_REQUEST_NOTIFY_TO
SUPPORT_NOTIFY_TO=
# Demo accounts: plant administrator and the single-machine kiln demo
ULTRON_DEMO_PLANTADMIN_EMAIL=
ULTRON_DEMO_PLANTADMIN_PASSWORD=
ULTRON_DEMO_KILN_EMAIL=
ULTRON_DEMO_KILN_PASSWORD=
