{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ultron-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3100"
      ],
      "env": {
        "NEXT_DIST_DIR": ".next-preview"
      },
      "port": 3100
    },
    {
